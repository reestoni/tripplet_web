# TrippleT Web - settings of ONE instance on the VM (C:\TrippleTWeb\instances\<name>\web.env).
# Format: KEY=VALUE, one per line, # = comment. Read by run_server.ps1 when the service starts.

# --- which database -------------------------------------------------------------------------
# dev_local | dev | prod. The web app only starts with modes that are released in
# backend/app/core.py (ALLOWED_MODES) - dev/prod need the explicit go of the owner.
TRIPPLET_MODE=dev

# Port on 127.0.0.1 (the HTTPS proxy forwards to it). prod = 8000, test = 8100.
TRIPPLET_WEB_PORT=8100

# Name shown in the sidebar (empty for the real instance).
TRIPPLET_WEB_INSTANCE=test

# Requests slower than this (ms) are written to logs\service.log as "slow request" (default 800).
# TRIPPLET_WEB_SLOW_MS=800

# The proxy in front speaks HTTPS -> session cookie only over HTTPS. Keep 1 on the VM.
TRIPPLET_WEB_HTTPS=1

# DB connections in the pool (desktop = 5).
TRIPPLET_DB_POOL_SIZE=10

# --- file share --------------------------------------------------------------------------------
# The database stores attachment folders as H:\Technik\TrippleT\... A service sees no user drive
# mappings, so run_server.ps1 maps H: for the service process itself:
TRIPPLET_MAP_DRIVE=H:=\\heb-fil-003\heberlein

# Optional: other folders than the defaults (dev modes default to C:\ttt\..., prod to H:\Technik\TrippleT\...).
# For a test instance against the dev DB it is sensible to use a test folder on the VM or the share:
#TRIPPLET_DIR_TRIALSERIES_IMAGES=D:\TrippleTWebTest\TrialSeriesImages
#TRIPPLET_DIR_TRIALSERIES_PDFS=D:\TrippleTWebTest\TrialSeriesPDF
#TRIPPLET_DIR_REQUEST_IMAGES=D:\TrippleTWebTest\ExperimentRequestImages
#TRIPPLET_DIR_JET_FILES=D:\TrippleTWebTest\JetFiles
#TRIPPLET_DIR_TOPPLATE_FILES=D:\TrippleTWebTest\TopPlateFiles
#TRIPPLET_YARNSCOPE_DTY_DIR=H:\Technik\TrippleT\YarnScopeTDMS
#TRIPPLET_YARNSCOPE_ATY_DIR=H:\Technik\TrippleT\ATYtdms
#TRIPPLET_YARNSCOPE_MODELS_DIR=H:\Technik\YarnScope\models

# --- secrets (never in a release) ---------------------------------------------------------------
# Default: C:\ProgramData\TrippleT\db_secrets.enc + C:\ProgramData\TrippleT\secrets.enc (master key).
#TRIPPLET_SECRETS_PATH=C:\ProgramData\TrippleT\db_secrets.enc
#TRIPPLET_MASTER_KEY_PATH=C:\ProgramData\TrippleT\secrets.enc
# Session key; default <instance>\data\web_secret.key (created on first start).
#TRIPPLET_WEB_SECRET_PATH=
